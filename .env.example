# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public site address
NEXT_PUBLIC_SITE_URL=https://tigermaxjobs.com
# Paynow (paynow.co.zw > Integrations)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Mailgun (sending + inbound routes for apply.tigermaxjobs.com)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=apply.tigermaxjobs.com
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=
# Claude API for matching and cover letters
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Shared secret for cron and job import
CRON_SECRET=
# Minimum match score for automatic applications
AUTO_APPLY_MIN_SCORE=65
